Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(?:/|$) - [F,L]
</IfModule>

<FilesMatch "^(\.env|\.gitignore|composer(\.json|\.lock)?|composer-setup\.php|test_db\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
